# Copy to .env for local overrides. Defaults work out of the box (SQLite).
# .env is gitignored — real credentials never belong in this file.

# Local dev (default): SQLite file in the working directory
DATABASE_URL=sqlite:///./clinical.db

# PostgreSQL example (docker-compose uses this form):
# DATABASE_URL=postgresql+psycopg2://clinical:clinical@localhost:5432/clinical

# Which dataset seeds a fresh database: synthea | sample | auto
# SEED_SOURCE=auto

# --- Natural-language query layer (the Ask bar) and evals/run_eval.py -------
# Without a key the dashboard still runs — /query just returns 503.
#
# Which model answers. Anything in backend/llm/models.py; `python
# evals/run_eval.py --list-models` prints the list. Default: claude-opus-4-8.
# LLM_MODEL=gpt-oss-120b

# Provider 1 — Anthropic (any claude-* model).
# NOTE: a Claude Pro/Max subscription does NOT include this. API access is
# billed separately: create a key in the Console at platform.claude.com.
# ANTHROPIC_API_KEY=sk-ant-...

# Provider 2 — VT ARC's hosted open models (gpt-oss, GLM, Kimi, DeepSeek).
# Free to VT accounts; mint a key at llm.arc.vt.edu → user profile → Settings →
# Account → API keys. Docs: https://www.docs.arc.vt.edu/ai/011_llm_api_arc_vt_edu.html
# VTARC_API_KEY=
# VTARC_BASE_URL=https://llm-api.arc.vt.edu/api/v1
